#!/bin/sh
set -u

. /usr/local/lib/valkey-backup/common.sh
. /usr/local/lib/valkey-backup/topology.sh
. /usr/local/lib/valkey-backup/alert.sh
. /usr/local/lib/valkey-backup/restore.sh

STATE_DIR="$DATA_DIR/watchdog"
TLS_CERT=/tls/server.pem
SLOW_CHECK_SECONDS=600
STARTUP_GRACE_SECONDS=120
CERT_WARNING_DAYS=21
LINK_DOWN_GRACE_SECONDS=30

: "${WATCHDOG_INTERVAL_SECONDS:=30}"
: "${ALERT_REPEAT_HOURS:=6}"
: "${ALERT_MEMORY_PERCENT:=80}"
: "${ALERT_DISK_PERCENT:=80}"
: "${RESTORE_CHECK_INTERVAL_DAYS:=7}"

drop_privileges "$0" "$@"

validate_env() {
    require_integer_at_least WATCHDOG_INTERVAL_SECONDS 5
    require_integer_at_least ALERT_REPEAT_HOURS 1
    require_integer_at_least ALERT_MEMORY_PERCENT 1
    require_integer_at_least ALERT_DISK_PERCENT 1
    require_integer_at_least RESTORE_CHECK_INTERVAL_DAYS 1
    require_boolean BACKUP_ENABLED
    [ -z "${ALERT_TELEGRAM_BOT_TOKEN:-}" ] || require_env ALERT_TELEGRAM_CHAT_ID
}

now() {
    date -u +%s
}

state_of() {
    cat "$STATE_DIR/$1" 2>/dev/null
}

remember() {
    printf '%s' "$2" > "$STATE_DIR/$1"
}

forget() {
    rm -f "$STATE_DIR/$1"
}

seconds_since() {
    printf '%s' "$(($(now) - ${1:-0}))"
}

report() {
    check=$1
    status=$2
    shift 2
    last_alert=$(state_of "failing.$check")
    if [ "$status" = "ok" ]; then
        [ -n "$last_alert" ] || return 0
        alert "RESOLVED $check: $*" && forget "failing.$check"
        return 0
    fi
    [ "$(seconds_since "$started")" -lt "$STARTUP_GRACE_SECONDS" ] && return 0
    [ -n "$last_alert" ] && [ "$(seconds_since "$last_alert")" -lt "$((ALERT_REPEAT_HOURS * 3600))" ] && return 0
    alert "FAIL $check: $*" && remember "failing.$check" "$(now)"
}

valkey_answers() {
    case "$(timeout "$SENTINEL_TIMEOUT_SECONDS" valkey-cli PING 2>&1)" in
        PONG | LOADING*) return 0 ;;
        *) return 1 ;;
    esac
}

check_valkey_up() {
    valkey_answers && { report valkey_down ok "valkey answers again"; return 0; }
    report valkey_down fail "valkey does not answer PING"
    return 1
}

forget_checks_of_other_role() {
    if [ "$1" = "master" ]; then
        forget failing.replication_broken
        return 0
    fi
    forget since.replicas_missing
    for check in replicas_missing memory_high writes_rejected backup_stale restore_check_failed; do
        forget "failing.$check"
    done
}

check_role() {
    role=$(info_field replication role)
    previous=$(state_of role)
    remember role "$role"
    [ -n "$previous" ] && [ "$previous" != "$role" ] || return 0
    forget_checks_of_other_role "$role"
    alert "INFO role_changed: $previous -> $role"
    return 0
}

online_replicas() {
    valkey-cli INFO replication | tr -d '\r' | grep -cE '^slave[0-9]+:.*state=online'
}

expected_replicas() {
    printf '%s' "$(($(sentinel_hosts | wc -l) - 1))"
}

failing_for_at_least() {
    since=$(state_of "since.$1")
    [ -n "$since" ] || { since=$(now); remember "since.$1" "$since"; }
    [ "$(seconds_since "$since")" -ge "$2" ]
}

check_replicas() {
    online=$(online_replicas)
    expected=$(expected_replicas)
    if [ "$online" -ge "$expected" ]; then
        forget since.replicas_missing
        report replicas_missing ok "$online/$expected replicas connected"
        return 0
    fi
    failing_for_at_least replicas_missing "$LINK_DOWN_GRACE_SECONDS" || return 0
    report replicas_missing fail "$online/$expected replicas connected"
}

check_replication_link() {
    [ "$(info_field replication master_link_status)" = "up" ] && { report replication_broken ok "link to primary is up"; return 0; }
    down_for=$(info_field replication master_link_down_since_seconds)
    [ "${down_for:-0}" -ge "$LINK_DOWN_GRACE_SECONDS" ] || return 0
    report replication_broken fail "link to primary $(info_field replication master_host) down for ${down_for}s"
}

check_sentinel() {
    reply=$(timeout "$SENTINEL_TIMEOUT_SECONDS" valkey-cli -p "$SENTINEL_PORT" SENTINEL CKQUORUM "$SENTINEL_MASTER_NAME" 2>&1 | tr -d '\r')
    case "$reply" in
        OK*) report sentinel_unhealthy ok "$reply" ;;
        *) report sentinel_unhealthy fail "${reply:-sentinel does not answer}" ;;
    esac
}

check_memory() {
    used=$(info_field memory used_memory)
    limit=$(info_field memory maxmemory)
    [ "${limit:-0}" -gt 0 ] || return 0
    percent=$((used * 100 / limit))
    [ "$percent" -lt "$ALERT_MEMORY_PERCENT" ] && { report memory_high ok "memory at ${percent}% of maxmemory"; return 0; }
    report memory_high fail "memory at ${percent}% of maxmemory, writes fail with OOM at 100%"
}

oom_errors() {
    valkey-cli INFO errorstats | tr -d '\r' | sed -n 's/^errorstat_OOM:count=\([0-9]*\).*/\1/p' | awk '{ print $1 + 0 } END { if (NR == 0) print 0 }'
}

check_rejected_writes() {
    count=$(oom_errors)
    previous=$(state_of oom_errors)
    remember oom_errors "$count"
    [ -n "$previous" ] && [ "$count" -gt "$previous" ] && { report writes_rejected fail "$((count - previous)) writes rejected with OOM since last check"; return 0; }
    report writes_rejected ok "no new OOM rejections"
}

check_disk() {
    percent=$(df -P "$DATA_DIR" | awk 'NR == 2 { sub("%", "", $5); print $5 }')
    [ "$percent" -lt "$ALERT_DISK_PERCENT" ] && { report disk_high ok "disk at ${percent}%"; return 0; }
    report disk_high fail "disk at ${percent}% on $DATA_DIR"
}

check_certificate() {
    [ -r "$TLS_CERT" ] || return 0
    openssl x509 -in "$TLS_CERT" -noout -checkend "$((CERT_WARNING_DAYS * 86400))" > /dev/null && { report cert_expiring ok "certificate valid for more than $CERT_WARNING_DAYS days"; return 0; }
    report cert_expiring fail "TLS certificate expires $(openssl x509 -in "$TLS_CERT" -noout -enddate | cut -d= -f2)"
}

within_first_backup_window() {
    [ "$(seconds_since "$started")" -lt "$((BACKUP_INTERVAL_SECONDS * 2))" ]
}

check_backup_age() {
    [ "$(total_keys)" -gt 0 ] || { report backup_stale ok "dataset is empty, nothing to back up"; return 0; }
    latest=$(newest_backup 2>/dev/null) || { report backup_stale fail "cannot list backups in s3"; return 0; }
    [ -n "$latest" ] || { within_first_backup_window || report backup_stale fail "no backups in s3 yet"; return 0; }
    age=$(seconds_since "$(backup_epoch "$latest")")
    [ "$age" -le "$((BACKUP_INTERVAL_SECONDS * 2))" ] && { report backup_stale ok "newest backup $latest"; return 0; }
    report backup_stale fail "newest backup $latest is $((age / 3600))h old"
}

check_restore() {
    [ "$(seconds_since "$(state_of restore_checked)")" -ge "$((RESTORE_CHECK_INTERVAL_DAYS * 86400))" ] || return 0
    [ -n "$(newest_backup 2>/dev/null)" ] || return 0
    output=$(restore-check 2>&1)
    status=$?
    remember restore_checked "$(now)"
    [ "$status" -eq 0 ] && { report restore_check_failed ok "$(printf '%s' "$output" | tail -n 1)"; return 0; }
    report restore_check_failed fail "$(printf '%s' "$output" | tail -n 1)"
}

slow_checks_due() {
    [ "$(seconds_since "$(state_of slow_checked)")" -ge "$SLOW_CHECK_SECONDS" ]
}

run_slow_checks() {
    remember slow_checked "$(now)"
    check_disk
    check_certificate
    [ "$BACKUP_ENABLED" = "true" ] && is_primary || return 0
    check_backup_age
    check_restore
}

run_checks() {
    check_valkey_up || return 1
    check_role
    if is_primary; then
        sentinel_enabled && check_replicas
        check_memory
        check_rejected_writes
    else
        check_replication_link
    fi
    sentinel_enabled && check_sentinel
    slow_checks_due && run_slow_checks
    return 0
}

main() {
    validate_env
    mkdir -p "$STATE_DIR"
    started=$(now)
    alert_channels_configured || log "WARNING: no ALERT_WEBHOOK_URL or ALERT_TELEGRAM_BOT_TOKEN set, alerts go to this log only"
    log "checking every ${WATCHDOG_INTERVAL_SECONDS}s"
    while true; do
        run_checks && send_heartbeat
        sleep "$WATCHDOG_INTERVAL_SECONDS"
    done
}

main
