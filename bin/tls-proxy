#!/bin/sh
set -eu

. /usr/local/lib/valkey-backup/common.sh
. /usr/local/lib/valkey-backup/topology.sh
. /usr/local/lib/valkey-backup/acme.sh

TLS_DIR=/tls
PROXY_CONF=/tmp/haproxy.cfg
RENEW_CHECK_SECONDS=43200
RENEW_RETRY_SECONDS=300

: "${TLS_PROXY_PORT:=6380}"
: "${TLS_READ_PORT:=6381}"
: "${TLS_CLIENT_VERIFY:=required}"
: "${PRIMARY_PROBE_PORT:=8080}"

[ "$(id -u)" = "0" ] && acme_enabled && prepare_acme_dir
drop_privileges "$0" "$@"

validate_env() {
    validate_topology_env
    validate_acme_env
    require_integer_at_least TLS_PROXY_PORT 1
    require_integer_at_least PRIMARY_PROBE_PORT 1
    case "$TLS_CLIENT_VERIFY" in
        required | none) ;;
        *) fail "TLS_CLIENT_VERIFY must be required or none" ;;
    esac
    validate_read_env
    for file in server.pem ca.crt; do
        [ -r "$TLS_DIR/$file" ] || fail "$TLS_DIR/$file is missing or unreadable, create it with generate-certs"
    done
}

read_frontend_enabled() {
    [ -n "${READ_REPLICA_HOSTS:-}" ]
}

validate_read_env() {
    read_frontend_enabled || return 0
    require_ipv4_list READ_REPLICA_HOSTS
    require_integer_at_least TLS_READ_PORT 1
    [ "$TLS_READ_PORT" != "$TLS_PROXY_PORT" ] || fail "TLS_READ_PORT must differ from TLS_PROXY_PORT"
}

read_replica_hosts() {
    hosts_in "$READ_REPLICA_HOSTS"
}

own_address() {
    [ "$VALKEY_PRIVATE_IP" = "0.0.0.0" ] && { printf '127.0.0.1'; return; }
    printf '%s' "$VALKEY_PRIVATE_IP"
}

proxy_targets() {
    sentinel_enabled && { sentinel_hosts; return; }
    own_address
}

server_line() {
    printf '    server node-%s %s:%s check port %s%s\n' "$1" "$1" "$VALKEY_PORT" "$PRIMARY_PROBE_PORT" "${2:-}"
}

backend_servers() {
    for host in $(proxy_targets); do
        server_line "$host"
    done
}

is_read_replica() {
    read_replica_hosts | grep -qxF "$1"
}

read_backend_servers() {
    for host in $(read_replica_hosts); do
        server_line "$host"
    done
    for host in $(proxy_targets); do
        is_read_replica "$host" || server_line "$host" ' backup'
    done
}

served_certificate() {
    acme_enabled && { printf '%s/serving.pem' "$ACME_DIR"; return; }
    printf '%s/server.pem' "$TLS_DIR"
}

tls_bind() {
    printf 'bind :%s ssl crt %s ca-file %s/ca.crt verify %s' "$1" "$(served_certificate)" "$TLS_DIR" "$TLS_CLIENT_VERIFY"
}

probe_check() {
    cat <<EOF
    option httpchk
    http-check send meth GET uri $1
    http-check expect status 200
    default-server inter 1s fall 2 rise 2 on-marked-down shutdown-sessions
EOF
}

read_proxy_config() {
    read_frontend_enabled || return 0
    cat <<EOF

frontend valkey_read_tls
    $(tls_bind "$TLS_READ_PORT")
    use_backend valkey_replicas if { nbsrv(valkey_replicas) gt 0 }
    default_backend valkey_primary

backend valkey_replicas
    balance roundrobin
    option allbackups
$(probe_check /replica)
$(read_backend_servers)
EOF
}

write_config() {
    cat > "$PROXY_CONF" <<EOF
global
    log stdout format raw local0
    ssl-default-bind-options ssl-min-ver TLSv1.2

defaults
    mode tcp
    log global
    option tcplog
    option dontlognull
    option clitcpka
    option srvtcpka
    timeout connect 3s
    timeout check 2s
    timeout client 1h
    timeout server 1h

frontend valkey_tls
    $(tls_bind "$TLS_PROXY_PORT")
    default_backend valkey_primary

backend valkey_primary
$(probe_check /)
$(backend_servers)
EOF
    read_proxy_config >> "$PROXY_CONF"
}

refresh_certificate() {
    renew_acme_certificate || true
    write_serving_certificate "$TLS_DIR/server.pem"
}

seconds_until_next_renewal() {
    acme_certificate_ready && { printf '%s' "$RENEW_CHECK_SECONDS"; return; }
    printf '%s' "$RENEW_RETRY_SECONDS"
}

stop_proxy() {
    kill -TERM "$haproxy_pid" 2>/dev/null
    wait "$haproxy_pid"
    exit 0
}

keep_certificate_fresh() {
    trap stop_proxy TERM INT
    while kill -0 "$haproxy_pid" 2>/dev/null; do
        sleep "$(seconds_until_next_renewal)" &
        wait $! || true
        refresh_certificate || continue
        log "certificate for $ACME_DOMAIN updated, reloading the proxy"
        kill -USR2 "$haproxy_pid"
    done
}

main() {
    validate_env
    write_config
    log "TLS on :$TLS_PROXY_PORT (client certificates $TLS_CLIENT_VERIFY), routing to the primary among: $(proxy_targets | tr '\n' ' ')"
    read_frontend_enabled && log "TLS reads on :$TLS_READ_PORT, balanced across replicas: $(read_replica_hosts | tr '\n' ' ')"
    acme_enabled || exec haproxy -db -f "$PROXY_CONF"
    refresh_certificate || true
    acme_certificate_ready || log "WARNING: serving the private certificate until Let's Encrypt succeeds for $ACME_DOMAIN"
    haproxy -W -db -f "$PROXY_CONF" &
    haproxy_pid=$!
    keep_certificate_fresh
}

main
