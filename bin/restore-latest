#!/bin/sh
set -eu

. /usr/local/lib/valkey-backup/common.sh

newest_first() {
    sort -r
}

archive_is_valid() {
    expected=$(s3_expected_sha256 "$1")
    if [ -n "$expected" ] && [ "$(sha256_of "$2")" != "$expected" ]; then
        log "$1 checksum mismatch"
        return 1
    fi
    gzip -t "$2" 2>/dev/null || { log "$1 is not a valid gzip archive"; return 1; }
}

install_snapshot() {
    staging="$DATA_DIR/dump.rdb.restoring"
    gunzip -c "$1" > "$staging" || { log "could not unpack into $DATA_DIR"; return 1; }
    valkey-check-rdb "$staging" > /dev/null 2>&1 || { log "$2 is not a valid RDB snapshot"; rm -f "$staging"; return 1; }
    fsync "$staging" || return 1
    mv "$staging" "$DATA_DIR/dump.rdb" || return 1
    fsync "$DATA_DIR"
}

restore() {
    log "downloading $1"
    s3_download "$1" "$workdir/archive" || { log "download of $1 failed"; return 1; }
    archive_is_valid "$1" "$workdir/archive" || return 1
    install_snapshot "$workdir/archive" "$1" || return 1
    log "restored $1"
}

main() {
    validate_backup_env
    valkey_ping && fail "valkey is running, stop it before restoring"

    backups=$(backup_names) || fail "cannot list backups in s3"
    if [ -z "$backups" ]; then
        log "WARNING: no backups under s3://$S3_BUCKET/$BACKUP_PATH/, starting empty"
        exit 2
    fi

    workdir=$(mktemp -d "$BACKUP_TMP_DIR/backup.XXXXXX")
    trap 'rm -rf "$workdir" "$DATA_DIR/dump.rdb.restoring"' EXIT

    for name in $(printf '%s\n' "$backups" | newest_first); do
        restore "$name" && return 0
        log "falling back to the previous backup"
    done
    fail "no valid backup found under s3://$S3_BUCKET/$BACKUP_PATH/"
}

main
