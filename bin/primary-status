#!/bin/sh

. /usr/local/lib/valkey-backup/common.sh

request_path() {
    IFS=' ' read -r _ path _
    printf '%s' "$path" | tr -d '\r'
}

drain_request() {
    while IFS= read -r line; do
        [ -z "$(printf '%s' "$line" | tr -d '\r')" ] && return 0
    done
}

respond() {
    printf 'HTTP/1.1 %s\r\nContent-Type: text/plain\r\nContent-Length: %s\r\nConnection: close\r\n\r\n%s' "$1" "${#2}" "$2"
}

answer() {
    "$1" && { respond '200 OK' "$2"; return; }
    respond '503 Service Unavailable' "not $2"
}

path=$(request_path)
drain_request
case "$path" in
    /replica) answer is_synced_replica 'replica' ;;
    *) answer is_primary 'primary' ;;
esac
