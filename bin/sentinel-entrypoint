#!/bin/sh
set -eu

. /usr/local/lib/valkey-backup/common.sh
. /usr/local/lib/valkey-backup/topology.sh

SENTINEL_CONF="$DATA_DIR/sentinel.conf"

drop_privileges "$0" "$@"

validate_env() {
    validate_password
    validate_topology_env
    sentinel_enabled || fail "SENTINEL_HOSTS is required"
}

write_initial_config() {
    [ -s "$SENTINEL_CONF" ] && return 0
    primary=$(known_primary) || primary=$(first_sentinel_host)
    umask 077
    cat > "$SENTINEL_CONF" <<EOF
port $SENTINEL_PORT
bind $(bind_addresses)
dir $DATA_DIR
requirepass "$VALKEY_PASSWORD"
sentinel announce-ip $VALKEY_PRIVATE_IP
sentinel announce-port $SENTINEL_PORT
sentinel sentinel-pass $VALKEY_PASSWORD
sentinel monitor $SENTINEL_MASTER_NAME $primary $VALKEY_PORT $SENTINEL_QUORUM
sentinel auth-pass $SENTINEL_MASTER_NAME $VALKEY_PASSWORD
sentinel down-after-milliseconds $SENTINEL_MASTER_NAME 5000
sentinel failover-timeout $SENTINEL_MASTER_NAME 60000
sentinel parallel-syncs $SENTINEL_MASTER_NAME 1
EOF
    log "created $SENTINEL_CONF monitoring $primary"
}

main() {
    validate_env
    write_initial_config
    exec valkey-sentinel "$SENTINEL_CONF"
}

main
