#!/bin/sh
set -eu

WG_DIR=/etc/wireguard
WG_PORT=51820

fail() {
    echo "ERROR: $*" >&2
    exit 1
}

usage() {
    fail "usage: wireguard key | wireguard up <own-wg-ip> <peer-public-key>@<peer-public-ip>@<peer-wg-ip>..."
}

install_tools() {
    command -v wg > /dev/null && return 0
    apt-get update -qq && apt-get install -y -qq wireguard-tools > /dev/null
}

print_public_key() {
    install_tools
    umask 077
    [ -s "$WG_DIR/private.key" ] || wg genkey > "$WG_DIR/private.key"
    wg pubkey < "$WG_DIR/private.key"
}

peer_section() {
    public_key=${1%%@*}
    rest=${1#*@}
    endpoint=${rest%%@*}
    wg_ip=${rest#*@}
    printf '\n[Peer]\nPublicKey = %s\nEndpoint = %s:%s\nAllowedIPs = %s/32\nPersistentKeepalive = 25\n' "$public_key" "$endpoint" "$WG_PORT" "$wg_ip"
}

bring_up() {
    own_ip=$1
    shift
    [ -s "$WG_DIR/private.key" ] || fail "run 'wireguard key' first"
    umask 077
    {
        printf '[Interface]\nAddress = %s/24\nListenPort = %s\nPrivateKey = %s\n' "$own_ip" "$WG_PORT" "$(cat "$WG_DIR/private.key")"
        for peer in "$@"; do
            peer_section "$peer"
        done
    } > "$WG_DIR/wg0.conf"
    systemctl enable wg-quick@wg0 > /dev/null 2>&1
    systemctl restart wg-quick@wg0
    wg show wg0 | grep -E 'interface|peer|endpoint'
}

[ "$(id -u)" = "0" ] || fail "run as root"
case "${1:-}" in
    key) print_public_key ;;
    up)
        [ "$#" -ge 3 ] || usage
        shift
        bring_up "$@"
        ;;
    *) usage ;;
esac
